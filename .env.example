# PMC 医学文献 RAG API 环境变量配置模板
# 复制为 .env 并按需修改；.env 本身已加入 .gitignore，不会被提交。

# ── RAG 数据源 ────────────────────────────────────────────────────
# 默认指向小规模 test_dir_mode 集合。若指向全量 pmc_full，
# 加载 HNSW 索引约需 18-21GB 内存，请确认机器内存充足。
RAG_DB_DIR=d:\Rag-Med\pipeline_output\chroma_db
RAG_COLLECTION=test_dir_mode
RAG_BM25_CACHE=d:\Rag-Med\pipeline_output\bm25_index_test_dir_mode.pkl
RAG_LLM_MODEL=qwen2.5:7b-instruct
RAG_LLM_BASE_URL=http://localhost:11434

# ── 服务 ──────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── 会话管理 ──────────────────────────────────────────────────────
SESSION_TTL_SECONDS=3600
SESSION_MAX_TURNS=20

      "QARequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query",
            "description": "用户问题，非空，最长 2000 字符"
          },
          "top_k": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Top K",
            "description": "最终返回结果数量，1-20",
            "default": 8
          },
          "fusion_strategy": {
            "type": "string",
            "enum": [
              "rrf",
              "weighted",
              "simple"
            ],
            "title": "Fusion Strategy",
            "description": "多路检索融合策略",
            "default": "rrf"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id",
            "description": "会话 ID；传入则关联历史对话，不传则新建/不关联"
          },
          "run_evaluation": {
            "type": "boolean",
            "title": "Run Evaluation",
            "description": "是否执行证据评估阶段",
            "default": true
          },
          "run_review": {
            "type": "boolean",
            "title": "Run Review",
            "description": "是否执行批判性审查阶段",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "QARequest"
      },

{
  "openapi": "3.1.0",
  "info": {
    "title": "PMC Medical RAG API",
    "description": "基于 PMC oa_comm 医学文献的检索增强生成服务",
    "version": "0.2.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Check",
        "description": "健康检查：liveness（进程是否存活，能响应即代表存活）+ readiness\n（RAG 流水线是否已加载完成，未就绪时返回 ready=False 但不报错，\n供负载均衡器/编排系统区分\"正在启动\"与\"已崩溃\"）。",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseModel_dict_"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/qa": {
      "post": {
        "tags": [
          "qa"
        ],
        "summary": "Ask",
        "operationId": "ask_api_v1_qa_post",
